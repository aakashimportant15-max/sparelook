{
  "name": "sharespace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:expire": "tsx src/db/expire.ts",
    "demo:reset": "npm run db:reset && npm run db:migrate && npm run db:seed",
    "test:concurrency": "tsx tests/concurrency/run.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
