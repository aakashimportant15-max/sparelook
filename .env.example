# Copy to .env and fill local values. Never commit .env.
# Relative to the project root.
SHARESPACE_DB_PATH=./data/sharespace.db

# IANA time zone used for display and for interpreting local date-time input.
INSTITUTION_TIMEZONE=Asia/Kolkata

# Session lifetimes (hours)
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_HOURS=24

# Demo password used by the seed script for all seeded accounts.
# Leave empty to have the seed script generate one and print it once.
# Note: .env is git-ignored and must not be committed.
DEMO_USER_PASSWORD=

# Public origin used for CSRF origin checks in local development.
APP_ORIGIN=http://localhost:3000
